# Copia este archivo como .env y ajusta los valores.

# Base de datos MySQL 8 o MariaDB 10.6+. Créala (vacía) en phpMyAdmin con un usuario
# que tenga todos los permisos sobre ella; las tablas se crean solas al arrancar.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dialogue
DB_USER=dialogue
DB_PASSWORD=cambia-esta-contraseña
# También vale una URL en su lugar (con la contraseña codificada si lleva símbolos):
# DATABASE_URL=mysql://usuario:contraseña@localhost:3306/dialogue

PORT=3030
# En producción (con HTTPS) pon true para que la cookie de sesión solo viaje cifrada.
COOKIE_SECURE=false
# Zona horaria de la empresa: decide qué día y qué mes es "hoy".
TIMEZONE=Europe/Madrid
