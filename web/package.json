{
  "name": "contador-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web compartida de DIALOGUE: usuarios, clientes y tiempos confirmados.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "migrate": "node --env-file-if-exists=.env src/scripts/migrate.ts",
    "create-user": "node --env-file-if-exists=.env src/scripts/create-user.ts",
    "reset-password": "node --env-file-if-exists=.env src/scripts/reset-password.ts",
    "set-role": "node --env-file-if-exists=.env src/scripts/set-role.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
